<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 flavour of the TFM brings in Windows.Media.Ocr, used to read pages whose text layer is
         unusable. SupportedOSPlatformVersion stays at 1809 so the app still runs where OCR isn't available. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PDFPlus</RootNamespace>
    <AssemblyName>PDFPlus</AssemblyName>
    <Product>PDFPlus</Product>
    <Version>1.1.0</Version>
    <Copyright>Free forever. No subscriptions.</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PDFPlus.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Portable build: one self-contained exe, no installer, no runtime needed. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDFium (Chrome's PDF engine), BSD-3 licensed native build. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="155.0.8044" />
    <!-- PDFsharp (MIT): AES-256 password protection and object compaction on export. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PDFPlus.ico" />
  </ItemGroup>

</Project>
