<Window x:Class="PDFPlus.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PDFPlus.Views"
        Title="PDFPlus" Width="1280" Height="860" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" AllowDrop="True"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ToolSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar: logo, tabs, caption buttons -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image x:Name="LogoImage" Width="18" Height="18" Margin="14,4,10,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <DockPanel Grid.Column="1" LastChildFill="True">
                    <ToggleButton x:Name="HomeButton" DockPanel.Dock="Left" Content="&#xE80F;" FontSize="14" Height="30" MinWidth="34"
                                  Margin="0,6,6,0" Style="{StaticResource ToolToggle}" ToolTip="Home: recent files and tools"
                                  Click="OnHomeClick" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <ScrollViewer x:Name="TabScroller" DockPanel.Dock="Left" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled" Focusable="False" VerticalAlignment="Bottom"
                                  PreviewMouseWheel="OnTabScrollerWheel" WindowChrome.IsHitTestVisibleInChrome="True">
                        <ItemsControl x:Name="TabStrip" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TabBorder" Height="35" MinWidth="130" MaxWidth="230" Margin="0,0,2,0"
                                            CornerRadius="8,8,0,0" Padding="12,0,5,0" Background="Transparent"
                                            ToolTip="{Binding FullPath}" WindowChrome.IsHitTestVisibleInChrome="True"
                                            MouseDown="OnTabMouseDown" MouseMove="OnTabMouseMove">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontSize="8" Width="24" Height="24" MinWidth="24"
                                                    Padding="0" Margin="6,0,0,0" Style="{StaticResource ToolButton}" ToolTip="Close (Ctrl+W)"
                                                    Click="OnTabCloseClick" />
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}"
                                                       ToolTip="Password protected"
                                                       Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}" />
                                            <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="6,0,0,0" VerticalAlignment="Center"
                                                     Fill="{DynamicResource Brush.Accent}" ToolTip="Unsaved changes"
                                                     Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brush.TabHover}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brush.TabActive}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button DockPanel.Dock="Left" Content="&#xE710;" FontSize="12" Height="30" MinWidth="30" Margin="4,6,0,0"
                            Style="{StaticResource ToolButton}" ToolTip="Open a PDF (Ctrl+O)" Click="OnOpenClick"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Border />
                </DockPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimizeClick" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximizeClick" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnCloseWindowClick" />
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <!-- Style="{x:Null}" keeps the implicit separator style below from applying to this Border itself. -->
            <Border x:Name="Toolbar" Grid.Row="1" Style="{x:Null}" Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1" Padding="8,5">
                <Border.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource ToolButton}" />
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}" />
                    <Style TargetType="Border" BasedOn="{StaticResource ToolSeparator}" />
                </Border.Resources>
                <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="&#xE8A0;" ToolTip="Show or hide pages sidebar (F4)" Click="OnToggleSidebarClick" />
                        <Border />
                        <Button Content="&#xE74E;" ToolTip="Save (Ctrl+S)" Click="OnSaveClick" />
                        <Button Content="&#xE749;" ToolTip="Print (Ctrl+P)" Click="OnPrintClick" />
                        <Border />
                        <Button x:Name="UndoButton" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Click="OnUndoClick" />
                        <Button x:Name="RedoButton" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" Click="OnRedoClick" />
                        <Border />
                        <Button Content="&#xE70E;" ToolTip="Previous page" Click="OnPreviousPageClick" />
                        <TextBox x:Name="PageBox" Width="48" Height="28" HorizontalContentAlignment="Center" Padding="2,0"
                                 KeyDown="OnPageBoxKeyDown" GotKeyboardFocus="OnPageBoxFocus" LostKeyboardFocus="OnPageBoxLostFocus" />
                        <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Margin="7,0" Foreground="{DynamicResource Brush.TextDim}" />
                        <Button Content="&#xE70D;" ToolTip="Next page" Click="OnNextPageClick" />
                        <Border />
                        <Button Content="&#xE71F;" ToolTip="Zoom out (Ctrl+-)" Click="OnZoomOutClick" />
                        <Button x:Name="ZoomButton" Content="100%" MinWidth="60" FontFamily="{StaticResource UiFont}" FontSize="13"
                                ToolTip="Zoom options" Click="OnZoomMenuClick" />
                        <Button Content="&#xE8A3;" ToolTip="Zoom in (Ctrl++)" Click="OnZoomInClick" />
                        <ToggleButton x:Name="FitWidthButton" Content="&#xE9A6;" ToolTip="Fit width (Ctrl+2)" Click="OnFitWidthClick" />
                        <ToggleButton x:Name="FitPageButton" Content="&#xE740;" ToolTip="Fit page (Ctrl+0)" Click="OnFitPageClick" />
                        <Border />
                        <Button ToolTip="Rotate left" Click="OnRotateLeftClick">
                            <TextBlock Text="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                        <Button Content="&#xE7AD;" ToolTip="Rotate right" Click="OnRotateRightClick" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="&#xE721;" ToolTip="Find (Ctrl+F)" Click="OnFindClick" />
                        <Button Content="&#xE706;" ToolTip="Switch light / dark theme" Click="OnThemeClick" />
                        <Button x:Name="MoreButton" Content="&#xE712;" ToolTip="More" Click="OnMoreClick" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,6,0">
                        <ToggleButton x:Name="SelectToolButton" Content="&#xE8B3;" ToolTip="Select text (V)" Click="OnSelectToolClick" />
                        <ToggleButton x:Name="HandToolButton" Content="&#xE7C9;" ToolTip="Hand tool (H)" Click="OnHandToolClick" />
                        <Border />
                        <ToggleButton x:Name="EditModeButton" ToolTip="Edit text and images (E)" Click="OnEditModeClick" Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AC;" VerticalAlignment="Center" />
                                <TextBlock Text="Edit" FontFamily="{StaticResource UiFont}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="AnnotateModeButton" ToolTip="Highlight, draw and comment" Click="OnAnnotateModeClick" Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76D;" VerticalAlignment="Center" />
                                <TextBlock Text="Annotate" FontFamily="{StaticResource UiFont}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="FillSignModeButton" ToolTip="Type text, tick boxes and sign" Click="OnFillSignModeClick" Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" VerticalAlignment="Center" />
                                <TextBlock Text="Fill &amp; Sign" FontFamily="{StaticResource UiFont}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Border />
                        <Button x:Name="PagesButton" ToolTip="Page tools" Click="OnPagesMenuClick" Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C3;" VerticalAlignment="Center" />
                                <TextBlock Text="Pages" FontFamily="{StaticResource UiFont}" FontSize="13" Margin="7,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontSize="9" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Second row for the active tool mode -->
                <Grid x:Name="ToolRow" Margin="0,5,0,0" Visibility="Collapsed">
                    <StackPanel x:Name="AnnotateRow" Orientation="Horizontal" Visibility="Collapsed">
                        <ToggleButton Tag="Highlight" ToolTip="Highlight: drag across text" Click="OnAnnotationToolClick" FontFamily="{StaticResource UiFont}" FontSize="13">
                            <Border Style="{x:Null}" Background="#66FFD400" Padding="3,0" CornerRadius="2">
                                <TextBlock Text="ab" />
                            </Border>
                        </ToggleButton>
                        <ToggleButton Tag="Underline" ToolTip="Underline: drag across text" Click="OnAnnotationToolClick" FontFamily="{StaticResource UiFont}" FontSize="13">
                            <TextBlock Text="ab" TextDecorations="Underline" />
                        </ToggleButton>
                        <ToggleButton Tag="Strikeout" ToolTip="Strike out: drag across text" Click="OnAnnotationToolClick" FontFamily="{StaticResource UiFont}" FontSize="13">
                            <TextBlock Text="ab" TextDecorations="Strikethrough" />
                        </ToggleButton>
                        <Border />
                        <ToggleButton Tag="Pen" Content="&#xE76D;" ToolTip="Draw freehand" Click="OnAnnotationToolClick" />
                        <ToggleButton Tag="Rectangle" Content="&#xE71A;" ToolTip="Rectangle" Click="OnAnnotationToolClick" />
                        <ToggleButton Tag="Ellipse" Content="&#xEA3A;" ToolTip="Ellipse" Click="OnAnnotationToolClick" />
                        <ToggleButton Tag="Arrow" ToolTip="Arrow" Click="OnAnnotationToolClick">
                            <TextBlock Text="&#xE72A;" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="-45" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </ToggleButton>
                        <ToggleButton Tag="Note" Content="&#xE90A;" ToolTip="Sticky note" Click="OnAnnotationToolClick" />
                        <Border />
                        <StackPanel x:Name="ColorSwatches" Orientation="Horizontal" />
                        <Border />
                        <StackPanel x:Name="WidthChoices" Orientation="Horizontal" />
                        <Border />
                        <TextBlock Text="Click an annotation to select it, Del removes it" VerticalAlignment="Center" Margin="4,0"
                                   FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                    </StackPanel>

                    <StackPanel x:Name="EditRow" Orientation="Horizontal" Visibility="Collapsed">
                        <Button ToolTip="Add a picture from a file (you can also drop one onto the page)" Click="OnAddImageClick" Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB9F;" VerticalAlignment="Center" />
                                <TextBlock Text="Add image" FontFamily="{StaticResource UiFont}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border />
                        <TextBlock Text="Click text to retype it  ·  drag text or images to move them  ·  drag a corner to resize  ·  Del removes"
                                   VerticalAlignment="Center" Margin="4,0" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                    </StackPanel>

                    <StackPanel x:Name="FillSignRow" Orientation="Horizontal" Visibility="Collapsed">
                        <ToggleButton x:Name="TextStampButton" Content="&#xE8D2;" ToolTip="Add text" Click="OnTextStampClick" />
                        <ToggleButton x:Name="CheckStampButton" Content="&#xE73E;" ToolTip="Add checkmark" Click="OnCheckStampClick" />
                        <ToggleButton x:Name="CrossStampButton" Content="&#xE711;" ToolTip="Add cross" Click="OnCrossStampClick" />
                        <ToggleButton x:Name="DateStampButton" Content="&#xE787;" ToolTip="Add today's date" Click="OnDateStampClick" />
                        <ToggleButton x:Name="SignButton" ToolTip="Sign" Click="OnSignClick" Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" VerticalAlignment="Center" />
                                <TextBlock Text="Sign" FontFamily="{StaticResource UiFont}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Border />
                        <TextBlock Text="Interactive form fields can be filled directly on the page" VerticalAlignment="Center" Margin="4,0"
                                   FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                    </StackPanel>
                </Grid>
                </StackPanel>
            </Border>

            <!-- Documents -->
            <Grid x:Name="DocumentHost" Grid.Row="2" />

            <!-- Home: shown when no document tab is active -->
            <views:HomeView x:Name="Home" Grid.Row="2" />
        </Grid>
    </Border>
</Window>
