<UserControl x:Class="PDFPlus.Views.TextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Background="{DynamicResource Brush.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- A quiet note about the document, such as Word features that won't be kept. Dismissible, never modal. -->
        <Border x:Name="NoticeBar" Grid.Row="0" Visibility="Collapsed" Padding="12,7"
                Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="9"
                        Width="24" Height="24" Margin="8,0,0,0" Style="{StaticResource ToolButton}"
                        ToolTip="Dismiss" Click="OnDismissNoticeClick" />
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center"
                           FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" />
            </DockPanel>
        </Border>

        <!-- Find and replace, shown on Ctrl+F -->
        <Border x:Name="FindBar" Grid.Row="1" Visibility="Collapsed" Padding="8,6"
                Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="FindBox" Width="220" Height="28" Padding="6,0" VerticalContentAlignment="Center"
                         KeyDown="OnFindBoxKeyDown" TextChanged="OnFindTextChanged" />
                <Button Content="&#xE70E;" FontFamily="{StaticResource IconFont}" Width="30" Height="28" Margin="4,0,0,0"
                        Style="{StaticResource ToolButton}" ToolTip="Previous (Shift+F3)" Click="OnFindPreviousClick" />
                <Button Content="&#xE70D;" FontFamily="{StaticResource IconFont}" Width="30" Height="28" Margin="2,0,0,0"
                        Style="{StaticResource ToolButton}" ToolTip="Next (F3)" Click="OnFindNextClick" />
                <TextBox x:Name="ReplaceBox" Width="220" Height="28" Margin="12,0,0,0" Padding="6,0" VerticalContentAlignment="Center"
                         KeyDown="OnReplaceBoxKeyDown" />
                <Button Content="Replace" Height="28" MinWidth="70" Margin="4,0,0,0" Padding="10,0"
                        FontFamily="{StaticResource UiFont}" FontSize="13" Style="{StaticResource ToolButton}" Click="OnReplaceClick" />
                <Button Content="Replace all" Height="28" MinWidth="86" Margin="2,0,0,0" Padding="10,0"
                        FontFamily="{StaticResource UiFont}" FontSize="13" Style="{StaticResource ToolButton}" Click="OnReplaceAllClick" />
                <CheckBox x:Name="MatchCaseBox" Content="Match case" Margin="12,0,0,0" VerticalAlignment="Center"
                          FontFamily="{StaticResource UiFont}" FontSize="13" Click="OnFindOptionChanged" />
                <TextBlock x:Name="FindStatus" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                <Button Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="9" Width="28" Height="28" Margin="8,0,0,0"
                        Style="{StaticResource ToolButton}" ToolTip="Close (Esc)" Click="OnCloseFindClick" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,24,0,40" PreviewMouseWheel="OnScrollerWheel">
            <!-- Pages drawn behind the text, with the editor flowing over them; see PageLayout. -->
            <Grid x:Name="Sheet" Margin="24,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="SheetScale" />
                </Grid.LayoutTransform>
                <Canvas x:Name="PageBackdrop" />
                <RichTextBox x:Name="Editor" BorderThickness="0" Background="Transparent" Padding="0"
                             VerticalAlignment="Top"
                             Foreground="{DynamicResource Brush.Text}" AcceptsTab="True"
                             SelectionBrush="{DynamicResource Brush.Selection}"
                             VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                             SpellCheck.IsEnabled="True" />
            </Grid>
        </ScrollViewer>

        <!-- Real pages, laid out and stacked like Word. Paginated output cannot be edited, so this is read-only. -->
        <DocumentViewer x:Name="PageViewer" Grid.Row="2" Visibility="Collapsed"
                        Background="{DynamicResource Brush.Canvas}">
            <DocumentViewer.Template>
                <!-- Just the pages: the stock template brings a toolbar and a find bar that duplicate ours. -->
                <ControlTemplate TargetType="DocumentViewer">
                    <Border Background="{TemplateBinding Background}" Focusable="False">
                        <ScrollViewer x:Name="PART_ContentHost" CanContentScroll="True" Focusable="False"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    </Border>
                </ControlTemplate>
            </DocumentViewer.Template>
        </DocumentViewer>
    </Grid>
</UserControl>
